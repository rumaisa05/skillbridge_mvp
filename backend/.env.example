# Copy to .env and adjust (local development)
# SQLite is fine locally. On a free host use a Postgres URL (e.g. from Neon).
DATABASE_URL=sqlite:///./skillbridge.db

# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left empty, a random key is made on every start (everyone gets logged out on restart).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Extra allowed website origins (comma-separated, no trailing slash).
CORS_ORIGINS=https://skillbridge-mvp-zdwk.vercel.app

# AI mode: "mock" (no API key needed) or "llm"
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
